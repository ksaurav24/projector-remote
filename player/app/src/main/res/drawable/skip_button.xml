<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#9A3412" /><stroke android:width="2dp" android:color="#FDBA74" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#9A3412" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#E6222222" /><stroke android:width="1dp" android:color="#88FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
