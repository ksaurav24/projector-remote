<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:controller_layout_id="@layout/player_controls"
        app:show_timeout="3000" />

    <!-- Title card: fades in on each load, out after a few seconds. -->
    <LinearLayout
        android:id="@+id/title_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@drawable/title_scrim"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="64dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:textColor="#F5EFE8"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CCF5EFE8"
            android:textSize="18sp" />
    </LinearLayout>

    <Button
        android:id="@+id/skip_segment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="120dp"
        android:minHeight="48dp"
        android:minWidth="160dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="@drawable/skip_button"
        android:textColor="#F5EFE8"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Next-episode countdown. -->
    <LinearLayout
        android:id="@+id/countdown_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="48dp"
        android:background="@drawable/glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone">

        <com.projectorremote.player.CountdownRing
            android:id="@+id/countdown_ring"
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Up next"
                android:textColor="#A59C94"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="#F5EFE8"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Back to stay here"
                android:textColor="#A59C94"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error card: shown when the stream can't be played. -->
    <LinearLayout
        android:id="@+id/error_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_card"
        android:gravity="center_horizontal"
        android:maxWidth="560dp"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="Can't play this"
            android:textColor="#F5EFE8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#CCF5EFE8"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Press Back to close"
            android:textColor="#A59C94"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
