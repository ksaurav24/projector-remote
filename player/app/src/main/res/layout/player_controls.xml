<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal on-screen controls: play state and a time bar. Tracks,
     quality and next episode are driven from the phone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@drawable/controls_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:focusable="false"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFeatureSettings="tnum"
            android:textColor="#F5EFE8"
            android:textSize="16sp" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:focusable="false"
            app:bar_height="4dp"
            app:buffered_color="#55FFFFFF"
            app:played_color="#F97316"
            app:scrubber_color="#F97316"
            app:scrubber_enabled_size="14dp"
            app:unplayed_color="#26FFFFFF" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#A59C94"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
